{
  "character": "omnom",
  "version": 1,
  "decision": "D-51",
  "madeBy": "studio programmer (run 2026-09-30-offline-games), lab prototype games/lab/omnom-rig.html; to be moved next to omnom_rig.json by the art director",
  "units": "time in s; sq > 0 = stretch up, sq < 0 = squash; body scale around the feet sx = 1/(1+sq), sy = 1+sq (volume kept); lift = rig px up; lean = deg, + clockwise on screen; open = minimum mouth open 0..1; glance = gaze direction (-1..1) when the game gives no look target",
  "keysNote": "poseEase = separate ease for the pose (hold = pop exactly at the key, e.g. hands leave the face together with the mouth switch); pose = pose name (omnom_rig.json poses or this file's poses) or {name: weight}; a key without pose keeps the previous pose; sq/lift/lean/open/glance carry forward; bones = additive offsets for this key only ({t:[x,y], r: deg, s:[x,y] multiplies}); lids = replace lid weights for this key only. ease = how the segment ENDING at this key runs: lin, in, out, inout, hold (jump at the key). Mouth group switches (closed / open / sad / chew) happen exactly at the key where the new group appears - author those keys at a squash peak (D-51). A group change that is not authored (fade between clips, the open param) is delayed by blipMs/2 and gets a small squash blip.",
  "motion": {
    "squash":  { "f": 4.8, "zeta": 0.42, "r": 0.6, "max": 0.18, "note": "second-order follow of the keyed sq (t3ssel8r form: f Hz, zeta damping, r initial response): overshoot = jelly settle" },
    "lean":    { "f": 2.4, "zeta": 0.6, "r": 0.4 },
    "tilt":    { "f": 1.7, "zeta": 0.42, "r": 0.0, "maxDeg": 26, "note": "whole-body tilt on a rope / in flight, around the grip (rope) or the body centre (flight)" },
    "head":    { "f": 5.5, "zeta": 0.24, "gain": 0.55, "maxPx": 9, "note": "head lags vertical acceleration of the body (rig px)" },
    "sprout":  { "f": 2.3, "zeta": 0.22, "gains": [0.28, 0.36, 0.46], "maxDeg": 40, "tip": [316, 58], "note": "tip point on a spring in world space; deflection angle around sprout1 split over 3 links; lag 80-120 ms (D-51)" },
    "paws":    { "f": 2.5, "zeta": 0.18, "gains": { "paw_fl": 0.32, "paw_fr": 0.25, "paw_bl": 0.2, "paw_br": 0.28 }, "maxDeg": 14, "point": [281, 455], "note": "dangle only when air > 0 (rope, flight)" },
    "gaze":    { "tauMs": 70, "leanDelayMs": 100, "leanMaxDeg": 8, "lookPx": 70, "fullDistPx": 260, "note": "pupils first (exp. smoothing tau), body lean follows the same look 100 ms later; each pupil clamped into the travel ellipse of ITS eye (omnom_rig.json anchors.pupils)" },
    "blink":   { "closeMs": 45, "holdMs": 30, "openMs": 55, "everyS": [2, 5] },
    "breath":  { "periodS": 1.6, "sq": 0.016 },
    "groupSwitch": { "blipSq": -0.06, "blipMs": 90 },
    "open":    { "stops": [["neutral", 0], ["ajar", 0.3], ["wide", 0.65], ["wide2", 1]], "note": "open 0..1 -> face; neutral->ajar switches the mouth group at 0.15 (blip)" },
    "speedStretch": { "max": 0.2, "note": "speed 0..1 -> stretch along the velocity (squash pivot moves to the body centre in the air)" },
    "fade": 0.15
  },
